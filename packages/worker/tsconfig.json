{
  // Worker 单独的类型检查上下文：只引入 Workers 运行时类型，避免与站点的
  // SvelteKit / DOM 类型互相污染。由 `pnpm check:worker` 执行。
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2023"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types"],
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true
  },
  "include": ["./**/*.ts"],
  // 测试文件走 vitest（esbuild 转译加 oxlint 类型检查），不进 Worker 的类型上下文：
  // 那里只有 Workers 运行时类型，没有 vitest 与 Node 的类型
  "exclude": ["./**/*.test.ts"]
}
