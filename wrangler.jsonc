{
  // 站点以 Cloudflare Workers 静态资源形式部署，另有薄 Worker 处理 mirror 动态路由。
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "miyakomeow-site",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-19",
  "assets": {
    // 与 svelte.config.ts 中 adapter-static 的 pages/assets 输出保持一致
    "directory": "./build",
    "binding": "ASSETS",
    // 站点全局 trailingSlash="always"，构建产物为 <route>/index.html
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // mirror 前缀与写接口先走 Worker，其余请求直接由静态资源处理
    "run_worker_first": ["/bms/table/mirror/*", "/api/*"],
  },
  // 镜像数据桶绑定：Worker 读用户层、写增删与治理记录（user/ 前缀）。
  // 桶名入库是 2026-09 的显式取舍——绑定是部署期配置，无法用 secret 注入；
  // 桶内访问仍由公开域与凭据控制，凭据不入库。
  "r2_buckets": [{ "binding": "MIRROR_BUCKET", "bucket_name": "bms-table-mirror" }],
  "routes": [
    { "pattern": "miyakomeow.site", "custom_domain": true },
    { "pattern": "www.miyakomeow.site", "custom_domain": true },
  ],
}
