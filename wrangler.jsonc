{
  // 站点以 Cloudflare Workers 静态资源形式部署，另有薄 Worker 处理 mirror 动态路由。
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brightmeows-site",
  "main": "./packages/worker/index.ts",
  "compatibility_date": "2026-09-19",
  "assets": {
    // 多语构建组装后的主站树：en 根 + `_i18n/zh-cn`、`_i18n/ja` 内部前缀（scripts/build-site.ts）；
    // 跳转壳的 build-static/ 不经这里部署
    "directory": "./build",
    "binding": "ASSETS",
    // 站点全局 trailingSlash="always"，构建产物为 <route>/index.html
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // 边缘语言分发：全部请求先走 Worker（cookie/Accept-Language 选语言树），
    // 镜像前缀与写接口的判定也在其中（见 packages/worker/i18n.ts 与 index.ts）
    "run_worker_first": true,
  },
  // 镜像数据桶绑定：Worker 读写表数据与备份快照；用户层已迁 D1（见下）。
  // 桶名入库是 2026-09 的显式取舍——绑定是部署期配置，无法用 secret 注入；
  // 桶内访问仍由公开域与凭据控制，凭据不入库。
  "r2_buckets": [{ "binding": "MIRROR_BUCKET", "bucket_name": "bms-table-mirror" }],
  // 用户层数据库：增删改、审计、限次与抓取状态。schema 由 Worker 自持
  // （packages/worker/schema.ts 的幂等初始化），不走 wrangler d1 migrations，因此部署
  // 流程不需要 D1 权限。
  "d1_databases": [
    {
      "binding": "MIRROR_DB",
      "database_name": "brightmeows-user",
      "database_id": "99d6199c-44f1-439c-8f56-2cd4ecd85654",
    },
  ],
  // 部署期变量：Worker 的 R2 基址与清单对象键不再 import config/site.json，
  // 改为从 env 读取；config/site.json 仍是权威源，一致性由
  // scripts/check-site-config.ts 的第 6 条断言守住。
  "vars": {
    "R2_BASE": "https://bms-table-mirror-r2.brightmeows.com",
    "R2_MANIFEST_OBJECT": "tables/tables.json",
  },
  "routes": [
    { "pattern": "brightmeows.com", "custom_domain": true },
    { "pattern": "www.brightmeows.com", "custom_domain": true },
    { "pattern": "brightmeows.cn", "custom_domain": true },
    { "pattern": "www.brightmeows.cn", "custom_domain": true },
    { "pattern": "github-pages.miyakomeow.site", "custom_domain": true },
    { "pattern": "codeberg-pages.miyakomeow.site", "custom_domain": true },
  ],
  // 定时任务：每天 UTC 18:30（北京时间 02:30）把用户层导出成 R2 快照，
  // 保留最近 14 份（见 packages/worker/backup.ts）。免费账户可建 5 个 cron trigger。
  "triggers": {
    "crons": ["30 18 * * *"],
  },
}
