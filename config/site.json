{
  "origin": "https://brightmeows.com",
  "targets": [
    {
      "name": "cloudflare",
      "kind": "worker",
      "hosts": [
        "brightmeows.com",
        "www.brightmeows.com",
        "brightmeows.cn",
        "www.brightmeows.cn",
        "github-pages.brightmeows.com",
        "github-pages.miyakomeow.site",
        "codeberg-pages.miyakomeow.site",
        "miyakomeow.site",
        "www.miyakomeow.site"
      ]
    },
    {
      "name": "codeberg-pages",
      "kind": "redirect",
      "siteBase": "https://codeberg-pages.brightmeows.com",
      "legacyHosts": ["brightmeows.codeberg.page"],
      "pagesServer": "codeberg.page"
    }
  ],
  "r2": {
    "base": "https://bms-table-mirror-r2.brightmeows.com",
    "manifestObject": "tables/tables.json",
    "corsOrigins": [
      "https://brightmeows.com",
      "https://miyakomeow.site",
      "https://github-pages.miyakomeow.site",
      "https://codeberg-pages.miyakomeow.site",
      "https://brightmeows.github.io",
      "https://brightmeows.codeberg.page",
      "http://localhost:5173",
      "http://localhost:5174",
      "http://localhost:5175",
      "http://localhost:4173",
      "http://localhost:4174",
      "http://localhost:4175",
      "http://localhost:8787",
      "http://127.0.0.1:8787"
    ]
  }
}
