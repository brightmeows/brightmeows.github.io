{
  "name": "brightmeows-site",
  "private": true,
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=11.25.0 <12.0.0"
    }
  },
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "node scripts/build-site.ts",
    "build:flavor": "vite build",
    "prepare": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide && svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "check:worker": "tsc -p packages/worker/tsconfig.json",
    "check:mirror": "tsc -p packages/mirror/tsconfig.json",
    "check:bms": "tsc -p packages/bms/tsconfig.json",
    "test": "vitest run",
    "test:parity": "vitest run --config vitest.parity.config.ts",
    "lint": "svelte-kit sync && oxlint --deny-warnings --report-unused-disable-directives",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check:config": "node scripts/check-site-config.ts",
    "check:redirects": "node scripts/check-redirect-rules.ts",
    "check:i18n": "node scripts/check-i18n-coverage.ts",
    "check:jsdoc": "node scripts/check-jsdoc.ts",
    "check:quotes": "git ls-files -z -- '*.md' '*.svx' '*.ts' '*.svelte' '*.js' '*.py' '*.yml' '*.yaml' '*.json' '*.jsonc' '*.toml' '*.css' '*.html' ':(exclude)static/**' | xargs -0 -r python3 scripts/check-cn-quotes.py",
    "check:md": "git ls-files -z -- '*.md' ':(exclude)content/**' ':(exclude)static/**' | xargs -0 -r markdownlint --config .markdownlint.toml && git ls-files -z -- 'content/**/*.md' | xargs -0 -r markdownlint --config .markdownlint.toml --disable MD013 MD025 MD033 --"
  },
  "dependencies": {
    "@brightmeows/bms": "workspace:*",
    "@brightmeows/mirror": "workspace:*"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.29.3",
    "@nvl/sveltex": "^0.5.1",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "gray-matter": "^4.0.3",
    "katex": "^0.18.2",
    "markdownlint-cli": "^0.50.0",
    "opencc-js": "^1.4.2",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.90.0",
    "oxlint-tailwindcss": "^1.17.1",
    "oxlint-tsgolint": "^7.0.2006",
    "parse5": "^8.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-retext": "^6.0.1",
    "shiki": "^4.6.0",
    "smol-toml": "^1.9.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "unified": "^11.0.5",
    "valibot": "^1.5.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.156.0"
  },
  "imports": {
    "#posts/*": "./content/posts/*",
    "#lib/*": "./src/lib/*"
  }
}
