{
  "name": "miyakomeow-site",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "pnpm prebuild && vite dev",
    "prebuild": "jq '[.[] | .url_from = .url | .dir_name = \"[\" + (.url | capture(\"://(?<h>[^/]+)\").h) + \"] \" + .name | .url = (\"https://brightmeows.github.io/bms/table/mirror/\" + (.dir_name | @uri) + \"/\")]' static/bms/table/mirror/tables.raw.json > static/bms/table/mirror/tables.json",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide && svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "compilerOptions": {
    "types": [
      "src/vite-env.d.ts",
      "src/mdsvex.d.ts"
    ]
  },
  "exports": {},
  "devDependencies": {
    "@inlang/paraglide-js": "^2.25.2",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.5.1",
    "gray-matter": "^4.0.3",
    "katex": "^0.18.7",
    "mdsvex": "^0.12.8",
    "opencc-js": "^1.4.2",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "oxlint-tailwindcss": "^1.12.0",
    "oxlint-tsgolint": "^7.0.2001",
    "rehype-katex": "7.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "6.0.0",
    "remark-rehype": "^11.1.2",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "types": "^0.1.1",
    "typescript": "^6.0.3",
    "unified": "^11.0.5",
    "vite": "^8.3.0"
  }
}
