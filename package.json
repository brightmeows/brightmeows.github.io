{
  "name": "miyakomeow-site",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "pnpm prebuild && vite dev",
    "prebuild": "jq '[.[] | .url_from = .url | .dir_name = \"[\" + (.url | capture(\"://(?<h>[^/]+)\").h) + \"] \" + .name | .url = (\"https://brightmeows.codeberg.page/bms/table/mirror/\" + (.dir_name | @uri) + \"/\")]' static/bms/table/mirror/tables.raw.json > static/bms/table/mirror/tables.json",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide && svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "oxlint && oxvelte lint src/",
    "lint:fix": "oxlint --fix && oxvelte lint --fix src/",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "compilerOptions": {
    "types": [
      "src/vite-env.d.ts",
      "src/mdsvex.d.ts"
    ]
  },
  "exports": {},
  "devDependencies": {
    "@inlang/paraglide-js": "2.18.0",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.58.0",
    "@sveltejs/vite-plugin-svelte": "7.0.0",
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/typography": "0.5.19",
    "@tailwindcss/vite": "4.2.4",
    "@types/node": "^25.6.0",
    "cookie": "1.1.1",
    "gray-matter": "4.0.3",
    "katex": "0.16.45",
    "mdsvex": "0.12.7",
    "opencc-js": "1.3.0",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.70.0",
    "oxlint-tailwindcss": "^1.3.2",
    "oxlint-tsgolint": "^0.23.0",
    "rehype-katex": "7.0.1",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-rehype": "11.1.2",
    "svelte": "5.55.5",
    "svelte-check": "4.4.7",
    "tailwindcss": "4.2.4",
    "types": "0.1.1",
    "typescript": "6.0.3",
    "unified": "11.0.5",
    "vite": "8.0.10"
  }
}
