{
  "name": "miyakomeow-site",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "pnpm prebuild && vite dev",
    "prebuild": "jq '[.[] | .url_from = .url | .dir_name = \"[\" + (.url | capture(\"://(?<h>[^/]+)\").h) + \"] \" + .name | .url = (\"https://brightmeows.codeberg.page/bms/table/mirror/\" + (.dir_name | @uri) + \"/\")]' static/bms/table/mirror/tables.raw.json > static/bms/table/mirror/tables.json",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide && svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "oxlint && oxvelte lint src/",
    "lint:fix": "oxlint --fix && oxvelte lint --fix src/",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "compilerOptions": {
    "types": [
      "src/vite-env.d.ts",
      "src/mdsvex.d.ts"
    ]
  },
  "exports": {},
  "devDependencies": {
    "@inlang/paraglide-js": "^2.19.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^25.9.3",
    "cookie": "^1.1.1",
    "gray-matter": "^4.0.3",
    "katex": "^0.17.0",
    "mdsvex": "^0.12.7",
    "opencc-js": "^1.3.1",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.70.0",
    "oxlint-tailwindcss": "^1.3.2",
    "oxlint-tsgolint": "^0.23.0",
    "rehype-katex": "5.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "3.0.1",
    "remark-rehype": "^11.1.2",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.3.1",
    "types": "^0.1.1",
    "typescript": "^6.0.3",
    "unified": "^11.0.5",
    "vite": "^8.0.16"
  }
}
